{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "commands"
  ],
  "host_permissions": [
    "https://music.apple.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "content/pageBridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "lib/i18n.js",
        "lib/storage.js",
        "lib/utils.js",
        "lib/icons.js",
        "lib/theme.js",
        "content/bridgeClient.js",
        "content/apiClient.js",
        "content/player.js",
        "lib/core.js",
        "lib/ui.js",
        "content/swipeOverlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-swipe": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "SongCleaner Öffnen/Schließen"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "media/fonts/*"
      ],
      "matches": [
        "https://music.apple.com/*"
      ]
    }
  ]
}